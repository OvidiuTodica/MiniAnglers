{%- comment -%}
  MiniAnglers — "Shipping confirmation" customer email (Settings > Notifications >
  Customer notifications > Shipping confirmation > Edit code). Shopify sends it when
  an order is marked Fulfilled; the courier and AWB typed in at that step fill the
  tracking card. Same look as order-confirmation.liquid. Shopify does not sync
  notification templates from the theme, so changes are pasted into Admin by hand.
  Email subject (separate field in Admin): Comanda {{ name }} a plecat spre tine
  Sameday AWBs get a tracking link built here when Shopify doesn't supply one.
{%- endcomment -%}
{%- assign first_name = customer.first_name | default: shipping_address.first_name | default: billing_address.first_name -%}

{%- assign is_partial = false -%}
{%- if fulfillment.item_count < item_count -%}{%- assign is_partial = true -%}{%- endif -%}

{%- assign gateways = transactions | map: 'gateway' | join: ' ' | downcase -%}
{%- assign is_cod = false -%}
{%- if gateways contains 'cash on delivery' or gateways contains '(cod)' or gateways contains 'ramburs' -%}{%- assign is_cod = true -%}{%- endif -%}

{%- assign carrier = fulfillment.tracking_company -%}
{%- assign carrier_dc = carrier | downcase -%}
{%- assign awb = fulfillment.tracking_numbers.first -%}
{%- assign track_url = fulfillment.tracking_url -%}
{%- comment -%} Shopify's "Other" carrier would print as "curierului Other"; name the courier from the link or the AWB instead {%- endcomment -%}
{%- if carrier_dc == 'other' or carrier_dc == 'altul' or carrier_dc == 'alt curier' -%}{%- assign carrier = '' -%}{%- assign carrier_dc = '' -%}{%- endif -%}
{%- assign url_dc = track_url | downcase -%}
{%- assign awb_head = awb | slice: 0, 4 | upcase -%}
{%- if carrier == blank -%}
  {%- if url_dc contains 'sameday' or awb_head == '1ONB' -%}{%- assign carrier = 'Sameday' -%}{%- assign carrier_dc = 'sameday' -%}{%- endif -%}
{%- endif -%}
{%- if track_url == blank and awb != blank and carrier_dc contains 'sameday' -%}
  {%- assign track_url = 'https://sameday.ro/status-colet/?awb=' | append: awb -%}
{%- endif -%}

{%- if is_partial and fulfillment_status == 'fulfilled' -%}
  {%- assign headline = 'Ultimele produse din comandă au plecat spre tine.' -%}
{%- elsif is_partial -%}
  {%- assign headline = 'O parte din comandă a plecat spre tine.' -%}
{%- else -%}
  {%- assign headline = 'Comanda ta a plecat spre tine.' -%}
{%- endif -%}

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Comanda {{ name }} a plecat spre tine</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { color-scheme: light only; supported-color-schemes: light only; }
    body { margin:0; padding:0; background:#F4F6F4; }
    a { color:#125E38; }
    @media (max-width:620px) {
      .wrap { width:100% !important; }
      .pad { padding-left:16px !important; padding-right:16px !important; }
      .hero-pad { padding:26px 22px 24px !important; }
      .h1 { font-size:24px !important; }
      .col { display:block !important; width:100% !important; padding:0 0 12px 0 !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#F4F6F4;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Comanda {{ name }} e la curier{% if awb != blank %}, AWB {{ awb }}{% endif %}. Poți urmări coletul online.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F4F6F4" style="background:#F4F6F4;">
    <tr>
      <td align="center" class="pad" style="padding:28px 16px 36px;">
        <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;font-family:'Plus Jakarta Sans',Arial,Helvetica,sans-serif;color:#181A18;">

          <!-- green band: logo, order number, headline, courier, tracking button -->
          <tr>
            <td class="hero-pad" bgcolor="#177A48" style="background:#177A48;border-radius:16px;padding:28px 32px 30px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" valign="middle"><a href="{{ shop.url }}" style="text-decoration:none;"><img src="https://cdn.shopify.com/s/files/1/1052/5039/0361/files/minianglers-email-logo-white.png" width="72" height="40" alt="MiniAnglers" style="display:block;border:0;width:72px;height:40px;"></a></td>
                  <td align="right" valign="middle" style="font-size:13px;font-weight:600;color:#CFE9DA;">Comanda {{ order_name | default: name }}</td>
                </tr>
              </table>
              <h1 class="h1" style="margin:24px 0 0;font-size:27px;line-height:1.2;font-weight:800;color:#FFFFFF;">{% if first_name != blank %}Salut, {{ first_name }}!{% else %}Salut!{% endif %}<br>{{ headline }}</h1>
              <p style="margin:10px 0 0;font-size:15.5px;line-height:1.55;color:#E1F0E7;">{% if carrier != blank %}Am predat coletul curierului {{ carrier }}.{% else %}Am predat coletul curierului.{% endif %}{% if is_partial and fulfillment_status != 'fulfilled' %} Restul produselor pleacă separat și îți scriem și atunci.{% endif %}</p>
              {%- if fulfillment.estimated_delivery_at %}
              <p style="margin:16px 0 0;"><span style="display:inline-block;background:#2B8A5A;border-radius:999px;padding:7px 13px;font-size:13px;font-weight:700;color:#FFFFFF;">Livrare estimată: {{ fulfillment.estimated_delivery_at | date: format: 'date' }}</span></p>
              {%- endif %}
              {%- if track_url != blank %}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                <tr><td bgcolor="#FFFFFF" style="background:#FFFFFF;border-radius:999px;"><a href="{{ track_url }}" style="display:inline-block;padding:13px 24px;font-size:15px;font-weight:800;color:#125E38;text-decoration:none;border-radius:999px;">Urmărește coletul</a></td></tr>
              </table>
              {%- elsif order_status_url %}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                <tr><td bgcolor="#FFFFFF" style="background:#FFFFFF;border-radius:999px;"><a href="{{ order_status_url }}" style="display:inline-block;padding:13px 24px;font-size:15px;font-weight:800;color:#125E38;text-decoration:none;border-radius:999px;">Vezi comanda</a></td></tr>
              </table>
              {%- endif %}
            </td>
          </tr>

          <tr><td style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr>

          <!-- courier + AWB, the one thing the customer came for -->
          {%- if fulfillment.tracking_numbers.size > 0 or carrier != blank %}
          <tr>
            <td bgcolor="#FFFFFF" style="background:#FFFFFF;border:1px solid #E5E8E5;border-radius:16px;padding:22px 24px;">
              <p style="margin:0 0 6px;font-size:16px;font-weight:800;color:#181A18;">Urmărirea coletului</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {%- if carrier != blank %}
                <tr>
                  <td style="padding:10px 0;font-size:14px;color:#6E736D;">Curier</td>
                  <td align="right" style="padding:10px 0;font-size:14.5px;font-weight:700;color:#181A18;">{{ carrier }}</td>
                </tr>
                {%- endif %}
                {%- for tracking_number in fulfillment.tracking_numbers %}
                  {%- assign row_url = fulfillment.tracking_urls[forloop.index0] -%}
                  {%- if row_url == blank and carrier_dc contains 'sameday' -%}{%- assign row_url = 'https://sameday.ro/status-colet/?awb=' | append: tracking_number -%}{%- endif -%}
                <tr>
                  <td style="padding:10px 0;border-top:1px solid #EDEFED;font-size:14px;color:#6E736D;">{% if fulfillment.tracking_numbers.size > 1 %}AWB {{ forloop.index }}{% else %}AWB{% endif %}</td>
                  <td align="right" style="padding:10px 0;border-top:1px solid #EDEFED;font-size:14.5px;font-weight:700;letter-spacing:0.02em;">{% if row_url != blank %}<a href="{{ row_url }}" style="color:#125E38;text-decoration:underline;">{{ tracking_number }}</a>{% else %}<span style="color:#181A18;">{{ tracking_number }}</span>{% endif %}</td>
                </tr>
                {%- endfor %}
              </table>
              <p style="margin:8px 0 0;font-size:13.5px;line-height:1.5;color:#6E736D;">Curierul te anunță în ziua livrării. Statusul din link se actualizează de fiecare dată când coletul e scanat.</p>
            </td>
          </tr>

          <tr><td style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr>
          {%- endif %}

          <!-- what's in this parcel (a partial shipment lists only its own items) -->
          <tr>
            <td bgcolor="#FFFFFF" style="background:#FFFFFF;border:1px solid #E5E8E5;border-radius:16px;padding:22px 24px;">
              <p style="margin:0 0 8px;font-size:16px;font-weight:800;color:#181A18;">În colet</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {%- for line in fulfillment.fulfillment_line_items %}
                  {%- assign item = line.line_item -%}
                <tr>
                  <td width="76" valign="middle" style="padding:10px 0;{% unless forloop.first %}border-top:1px solid #EDEFED;{% endunless %}">
                    {%- if item.image %}<img src="{{ item | img_url: 'compact_cropped' }}" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border-radius:10px;background:#EEEEEE;border:0;">{%- else %}<div style="width:64px;height:64px;border-radius:10px;background:#E7F3EC;"></div>{%- endif %}
                  </td>
                  <td valign="middle" style="padding:10px 0;{% unless forloop.first %}border-top:1px solid #EDEFED;{% endunless %}">
                    <p style="margin:0;font-size:14.5px;font-weight:700;color:#181A18;">{{ item.product.title | default: item.title }}</p>
                    <p style="margin:2px 0 0;font-size:13px;color:#6E736D;">{% if item.variant.title != blank and item.variant.title != 'Default Title' %}{{ item.variant.title }} · {% endif %}Cant. {% if line.quantity < item.quantity %}{{ line.quantity }} din {{ item.quantity }}{% else %}{{ line.quantity }}{% endif %}</p>
                    {%- for p in item.properties %}
                      {%- assign p_first_char = p.first | slice: 0 %}
                      {%- if p.last != blank and p_first_char != '_' %}
                    <p style="margin:6px 0 0;"><span style="display:inline-block;font-size:12px;font-weight:700;color:#125E38;background:#E7F3EC;border-radius:999px;padding:3px 9px;">{{ p.first }}: {{ p.last }}</span></p>
                      {%- endif %}
                    {%- endfor %}
                  </td>
                </tr>
                {%- endfor %}
              </table>
            </td>
          </tr>

          <tr><td style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr>

          <!-- address + payment, side by side on desktop, stacked on phones -->
          <tr>
            <td>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  {%- if shipping_address %}
                  <td class="col" width="50%" valign="top" style="padding-right:7px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#FFFFFF" style="background:#FFFFFF;border:1px solid #E5E8E5;border-radius:16px;padding:20px 22px;">
                      <p style="margin:0 0 10px;font-size:15px;font-weight:800;color:#181A18;">Livrăm la</p>
                      {%- comment -%} format_address emits its own <p>/<br> markup, so style a wrapper div (a <p> here would be split by the nested <p>) {%- endcomment -%}
                      <div style="margin:0;font-size:13.5px;line-height:1.6;color:#181A18;">{{ shipping_address | format_address | replace: '<p>', '<div style="margin:0;font-size:13.5px;line-height:1.6;color:#181A18;">' | replace: '</p>', '</div>' }}</div>
                    </td></tr></table>
                  </td>
                  {%- endif %}
                  <td class="col" width="50%" valign="top" style="padding-left:7px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#FFFFFF" style="background:#FFFFFF;border:1px solid #E5E8E5;border-radius:16px;padding:20px 22px;">
                      <p style="margin:0 0 10px;font-size:15px;font-weight:800;color:#181A18;">La livrare</p>
                      {%- if is_cod %}
                      <p style="margin:0;font-size:13.5px;line-height:1.6;color:#181A18;">Plătești <b style="color:#125E38;">{{ total_price | money }}</b> ramburs, direct curierului.</p>
                      {%- else %}
                      <p style="margin:0;font-size:13.5px;line-height:1.6;color:#181A18;">Comanda e plătită. Nu ai nimic de plătit curierului.</p>
                      {%- endif %}
                      <p style="margin:10px 0 0;font-size:13.5px;line-height:1.6;color:#6E736D;">Toate detaliile sunt în <a href="{{ order_status_url | default: shop.url }}" style="color:#125E38;font-weight:700;">pagina comenzii</a>.</p>
                    </td></tr></table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:24px 8px 0;font-size:14px;line-height:1.6;color:#181A18;">Ai o întrebare? Răspunde direct la acest email sau <a href="{{ shop.url }}/pages/contact" style="color:#125E38;font-weight:700;">scrie-ne</a>.</td>
          </tr>
          <tr>
            <td align="center" style="padding:16px 8px 0;font-size:11.5px;line-height:1.7;color:#8A8F89;">
              MiniAnglers, bacuri de nadă și suporturi printate 3D în Timiș<br>
              PFA Todica Ovidiu-Victor-Nicușor · CUI 52748161<br>
              <a href="{{ shop.url }}/pages/retur-si-rambursare" style="color:#6E736D;">Retur și rambursare</a> · <a href="{{ shop.url }}/pages/termeni-si-conditii" style="color:#6E736D;">Termeni și condiții</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
