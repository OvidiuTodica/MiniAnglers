{%- comment -%} Minimal branded cart (round one). Shows engraving line item properties. {%- endcomment -%}
<div class="page-wrap" data-cart-root data-money-format="{{ shop.money_format | escape }}">
  <h1 data-i18n="cart.title">Construcția ta</h1>

  {%- if cart.item_count == 0 -%}
    <p style="color:var(--steel-400)" data-i18n="cart.empty">Coșul tău este gol.</p>
    <a class="btn btn-glass btn-lg" href="{{ routes.root_url }}#cutii" style="margin-top:18px" data-i18n="cart.start">Începe personalizarea</a>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      {%- for item in cart.items -%}
        {%- comment -%}
          data-key is the line's stable Ajax Cart API id (variant + properties hash) —
          not its position, which shifts once another line is removed. ma-cart.js reads
          it straight off the row for both remove and the auto quantity update below.
        {%- endcomment -%}
        <div class="cart-row" data-cart-row data-key="{{ item.key }}" data-compare-unit="{{ item.variant.compare_at_price | default: 0 }}" style="display:flex;gap:18px;align-items:flex-start;padding:18px 0;border-bottom:1px solid var(--line-soft)">
          {%- if item.image -%}<img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" style="width:80px;height:80px;object-fit:cover;border-radius:var(--r-sm);border:1px solid var(--line)">{%- endif -%}
          <div style="flex:1">
            <div style="font-family:var(--font-display);font-weight:600;color:var(--steel-100)">{{ item.product.title }}</div>
            {%- for p in item.properties -%}
              {%- unless p.last == blank -%}
                <div style="font-family:var(--font-mono);font-size:12px;color:var(--teal);margin-top:4px">{{ p.first }}: {{ p.last }}</div>
              {%- endunless -%}
            {%- endfor -%}
            <div style="color:var(--steel-500);font-size:13px;margin-top:6px"><span data-i18n="cart.qty">Cant.</span>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty style="width:60px;background:var(--bg-0);border:1px solid var(--line);color:var(--steel-200);border-radius:8px;padding:8px 10px;margin-left:6px;font-size:16px">
            </div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px">
            <div style="font-family:var(--font-display);font-weight:600;color:var(--steel-100)">
              <s class="cart-was" data-cart-was{% unless item.variant.compare_at_price > item.final_price %} hidden{% endunless %}>{% if item.variant.compare_at_price > item.final_price %}{{ item.variant.compare_at_price | times: item.quantity | money }}{% endif %}</s>
              <span data-cart-line-price>{{ item.final_line_price | money }}</span>
            </div>
            <button type="button" class="cart-remove" data-cart-remove aria-label="Elimină din coș" data-i18n-aria="cart.remove">{% render 'ma-icon', icon: 'close' %}</button>
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%}
        Offer nudge: 2+ different pieces of the set on offer in the cart (and not the set
        itself) -> say how many of its pieces they have, what those cost, and the set price.
        Hidden by ma-cart.js as soon as a line is removed, so it never shows stale numbers.
      {%- endcomment -%}
      {%- assign offer = settings.offer_product -%}
      {%- if offer != blank and offer.available and settings.offer_parts.size > 0 -%}
        {%- assign part_ids = settings.offer_parts | map: 'id' -%}
        {%- assign have_set = false -%}
        {%- assign seen = '|' -%}
        {%- assign have_n = 0 -%}
        {%- assign have_sum = 0 -%}
        {%- for item in cart.items -%}
          {%- if item.product_id == offer.id -%}{%- assign have_set = true -%}{%- endif -%}
          {%- if part_ids contains item.product_id -%}
            {%- assign have_sum = have_sum | plus: item.final_line_price -%}
            {%- assign key = item.product_id | append: '|' | prepend: '|' -%}
            {%- unless seen contains key -%}
              {%- assign seen = seen | append: item.product_id | append: '|' -%}
              {%- assign have_n = have_n | plus: 1 -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign extra_n = settings.offer_extra | split: ',' | size -%}
        {%- assign total_n = settings.offer_parts.size | plus: extra_n -%}
        {%- if have_n >= 2 and have_set == false -%}
          {%- assign meter = have_n | times: 100 | divided_by: total_n -%}
          <div class="cart-nudge" data-offer-nudge>
            <div class="cart-nudge-text">
              <b><span data-i18n="offer.cart_have">Ai</span> {{ have_n }} <span data-i18n="offer.cart_of">din cele</span> {{ total_n }} <span data-i18n="offer.cart_pieces">piese din</span> {{ offer.title }}.</b>
              <p><span data-i18n="offer.cart_yours">Piesele tale:</span> {{ have_sum | money_without_trailing_zeros }}. <span data-i18n="offer.cart_full">Setul complet, cu toate</span> {{ total_n }} <span data-i18n="offer.cart_full2">piesele:</span> {{ offer.price | money_without_trailing_zeros }}.</p>
              <span class="cart-nudge-meter" aria-hidden="true"><i style="width:{{ meter }}%"></i></span>
            </div>
            <a class="cart-nudge-btn" href="{{ offer.url }}"><span data-i18n="offer.see">Vezi setul</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        No "Actualizează" button: quantity changes save themselves (ma-cart.js, on the
        input's change). updates[] stays as a no-JS fallback — Shopify applies it on any
        /cart POST, so "Finalizează comanda" still carries a hand-typed quantity through.
      {%- endcomment -%}
      <div style="display:flex;justify-content:flex-end;margin-top:24px">
        <div style="text-align:right">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--steel-500)" data-i18n="cart.subtotal">Subtotal</div>
          <div style="font-family:var(--font-display);font-weight:700;font-size:22px;color:var(--steel-100)" data-cart-subtotal>{{ cart.total_price | money }}</div>
        </div>
      </div>

      <button type="submit" name="checkout" class="btn btn-steel btn-lg" style="margin-top:20px;width:100%" data-i18n="cart.checkout">Finalizează comanda</button>
    </form>
  {%- endif -%}
</div>
