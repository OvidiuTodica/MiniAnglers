{%- assign eng_handle = settings.engraving_product.handle | default: 'gravare' -%}
<div class="page-wrap">
  <h1>Caută</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:480px;margin:18px 0">
    <div class="news">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Caută produse…" aria-label="Caută">
      <button type="submit" class="btn btn-steel btn-sm">Caută</button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- assign shown = search.results_count -%}
    {%- for item in search.results -%}
      {%- if item.object_type == 'product' and item.handle == eng_handle -%}{%- assign shown = shown | minus: 1 -%}{%- endif -%}
    {%- endfor -%}
    <p style="color:var(--steel-500);margin-bottom:18px">{{ shown }} rezultat(e) pentru „{{ search.terms | escape }}”.</p>
    <div class="product-grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' and item.handle != eng_handle -%}
          {% render 'ma-pcard', product: item %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
