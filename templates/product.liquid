{%- comment -%}
  MiniAnglers product page (RO default, EN via data-i18n).
  Personalization lives here: the product ships plain by default; the paid
  custom engraving (name / club / team code) has a live preview. The typed
  text travels as a line-item property on the main product; when
  settings.engraving_product is linked, its price is charged as a second
  cart line (see ma-product.js). Nothing about engraving is "free" — the
  owner removed every such claim on 2026-09-21.
{%- endcomment -%}
{%- assign eng_product = settings.engraving_product -%}
{%- if eng_product != blank -%}
  {%- assign eng_variant = eng_product.selected_or_first_available_variant -%}
{%- endif -%}
{%- if eng_variant != blank and eng_variant.available -%}
  {%- assign eng_price_display = eng_variant.price | money | prepend: '+' -%}
{%- else -%}
  {%- assign eng_price_display = settings.engraving_price_note | default: '+19 lei' -%}
{%- endif -%}

{%- comment -%}
  Sale: a Compare-at price above the price shows -X% and the old price crossed out
  (updated per variant by ma-product.js). Offer (Theme settings > Offer & sales): the
  set's page lists its pieces and the saving; each piece's page suggests the set.
  Savings come from ma-offer-sum, so they only show when every piece has a price.
{%- endcomment -%}
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign sale_pct = 0 -%}
{%- if cur.compare_at_price > cur.price -%}
  {%- assign sale_pct = cur.compare_at_price | minus: cur.price | times: 100.0 | divided_by: cur.compare_at_price | round -%}
{%- endif -%}
{%- assign offer = settings.offer_product -%}
{%- assign is_offer = false -%}
{%- assign is_part = false -%}
{%- assign offer_sum = 0 -%}
{%- assign offer_save = 0 -%}
{%- if offer != blank and offer.available -%}
  {%- if product.id == offer.id -%}
    {%- assign is_offer = true -%}
  {%- else -%}
    {%- for part in settings.offer_parts -%}
      {%- if part.id == product.id -%}{%- assign is_part = true -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if is_offer or is_part -%}
    {%- capture offer_sum -%}{% render 'ma-offer-sum' %}{%- endcapture -%}
    {%- assign offer_sum = offer_sum | strip | plus: 0 -%}
    {%- if offer_sum > 0 -%}{%- assign offer_save = offer_sum | minus: offer.price -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- assign offer_extras = settings.offer_extra | split: ',' -%}
{%- assign offer_extras_en = settings.offer_extra_en | split: ',' -%}

<div class="product-page page-wrap">
  <a class="eyebrow" href="{{ routes.all_products_collection_url }}" data-i18n="product.back">← Toate produsele</a>

  <div class="product-layout">
    <div class="product-gallery" data-product-gallery>
      <div class="product-media">
        {%- if product.featured_image -%}
          <img data-main-image src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" width="1000" height="667">
        {%- else -%}
          <div class="product-media-ph">{% render 'ma-placeholder' %}</div>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-thumbs" role="tablist" aria-label="Poze produs">
          {%- for image in product.images -%}
            <button type="button" class="thumb{% if forloop.first %} is-active{% endif %}" data-thumb
                    data-full="{{ image | image_url: width: 1000 }}"
                    aria-label="{{ image.alt | escape | default: product.title }}, poza {{ forloop.index }}">
              <img src="{{ image | image_url: width: 140 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <div class="product-price-row">
        <div class="product-price">{{ cur.price | money }}</div>
        <s class="product-was" data-compare{% if sale_pct == 0 %} hidden{% endif %}>{% if sale_pct > 0 %}{{ cur.compare_at_price | money }}{% endif %}</s>
        <span class="sale-chip" data-sale-pct{% if sale_pct == 0 %} hidden{% endif %}>-{{ sale_pct }}%</span>
        {%- if is_offer -%}<span class="offer-chip" data-i18n="promo.offer_tag">Ofertă</span>{%- endif -%}
      </div>

      {%- if is_offer -%}
        <div class="pdp-offer">
          <div class="pdp-offer-top">
            {%- if offer_save > 0 -%}
              <b><span data-i18n="promo.save">Economisești</span> {{ offer_save | money_without_trailing_zeros }}</b>
              <span><span data-i18n="promo.separately">Cumpărate separat:</span> {{ offer_sum | money_without_trailing_zeros }}</span>
            {%- else -%}
              <b data-i18n="offer.in_set">Ce e în set</b>
            {%- endif -%}
          </div>
          <ul class="pdp-offer-pieces">
            {%- for part in settings.offer_parts -%}
              <li>
                <a href="{{ part.url }}">
                  <span class="pdp-offer-img">{%- if part.featured_image -%}<img src="{{ part.featured_image | image_url: width: 220 }}" alt="" loading="lazy" width="220" height="147">{%- endif -%}</span>
                  <span class="pdp-offer-name">{{ part.title }}</span>
                </a>
              </li>
            {%- endfor -%}
            {%- for x in offer_extras -%}
              {%- assign x_en = offer_extras_en[forloop.index0] | strip -%}
              <li class="is-extra">
                <span class="pdp-offer-img">{% render 'ma-icon', icon: 'layers' %}</span>
                <span class="pdp-offer-name"{% if x_en != blank %} data-i18n-en="{{ x_en | escape }}"{% endif %}>{{ x | strip }}</span>
                <small data-i18n="offer.only_in_set">doar în set</small>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if product.tags.size > 0 -%}
        <div class="tags">
          {%- for tag in product.tags -%}<span>{{ tag }}</span>{%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Variant data for JS picker {%- endcomment -%}
      <script type="application/json" data-product-json>
        {
          "options": {{ product.options | json }},
          "variants": [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id }},
                "options": {{ v.options | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
                "available": {{ v.available }},
                "featured_image": {%- if v.featured_image -%}{{ v.featured_image | image_url: width: 900 | json }}{%- else -%}null{%- endif -%}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "money_format": {{ shop.money_format | json }}
        }
      </script>

      {%- form 'product', product -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_l = option.name | downcase -%}
            {%- assign is_color = false -%}
            {%- if opt_l == 'culoare' or opt_l == 'color' or opt_l == 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
            {%- if is_color -%}
              <div class="form-field">
                <label>{{ option.name }}</label>
                <div class="swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    {%- assign vl = value | downcase | strip -%}
                    {%- assign hex = '#888' -%}
                    {%- case vl -%}
                      {%- when 'albastru', 'blue' -%}{%- assign hex = '#2563eb' -%}
                      {%- when 'auriu', 'gold' -%}{%- assign hex = '#c9a96e' -%}
                      {%- when 'negru', 'black' -%}{%- assign hex = '#1a1a1a' -%}
                    {%- endcase -%}
                    {%- assign active = false -%}
                    {%- if option.selected_value == value -%}{%- assign active = true -%}{%- endif -%}
                    <button type="button"
                            class="swatch{% if active %} is-active{% endif %}"
                            data-option-name="{{ option.name | escape }}"
                            data-value="{{ value | escape }}"
                            style="--swatch-color:{{ hex }}"
                            role="radio"
                            aria-checked="{% if active %}true{% else %}false{% endif %}"
                            aria-label="{{ value | escape }}"
                            title="{{ value | escape }}">
                      <span class="swatch-color" aria-hidden="true"></span>
                      <span class="swatch-label">{{ value }}</span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <div class="form-field">
                <label for="opt-{{ forloop.index }}">{{ option.name }}</label>
                <select class="cfg-input" id="opt-{{ forloop.index }}" name="options[{{ option.name | escape }}]">
                  {%- for value in option.values -%}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- comment -%} Engraving widget — none (default) OR custom name (paid) {%- endcomment -%}
        <div class="engrave" data-product-engrave data-max="16"
             data-eng-price="{{ eng_price_display | escape }}"
             data-cart-url="{{ routes.cart_url }}"
             {%- if eng_variant != blank and eng_variant.available %} data-eng-variant="{{ eng_variant.id }}"{% endif %}>
          <div class="engrave-head">
            <span class="l" data-i18n="config.engraving">Gravare</span>
          </div>

          <div class="engrave-choices">
            <label class="eng-opt is-active" data-eng-opt="standard">
              <input type="radio" name="eng_choice" value="standard" checked>
              <span class="eng-opt-main">
                <span class="eng-opt-title" data-i18n="config.eng_standard">Fără gravare</span>
                <span class="eng-opt-sub" data-i18n="config.eng_standard_sub">Modelul standard</span>
              </span>
            </label>
            <label class="eng-opt" data-eng-opt="custom">
              <input type="radio" name="eng_choice" value="custom">
              <span class="eng-opt-main">
                <span class="eng-opt-title" data-i18n="config.eng_custom">Gravează numele tău</span>
                <span class="eng-opt-sub" data-eng-price-sub>{{ eng_price_display }}</span>
              </span>
            </label>
          </div>

          <input class="cfg-input" data-eng-input type="text" maxlength="16"
                 name="properties[Gravare]" placeholder="Numele tău"
                 data-i18n-ph="config.placeholder" aria-label="Text gravură" disabled hidden>
          <div class="engrave-count" data-eng-count hidden>0/16 caractere</div>

          <div class="engrave-preview" data-eng-preview hidden>
            <span class="glass-tag" data-i18n="product.preview">Previzualizare gravură</span>
            <div class="engrave-plate" data-eng-etch></div>
          </div>
        </div>

        <button type="submit" class="btn btn-steel btn-lg product-add" {% unless product.available %}disabled{% endunless %}>
          {% render 'ma-icon', icon: 'plus' %}
          {%- if product.available -%}<span data-i18n="product.add">Adaugă în coș</span>{%- else -%}<span data-i18n="product.soldout">Stoc epuizat</span>{%- endif -%}
        </button>

        <p class="pdp-trust">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span data-i18n="pdp.trust">Printat în Timiș, livrare în 4-5 zile.</span>
        </p>
      {%- endform -%}

      {%- if is_part -%}
        <a class="pdp-upsell" href="{{ offer.url }}">
          <span class="pdp-upsell-img">{%- if offer.featured_image -%}<img src="{{ offer.featured_image | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="267">{%- endif -%}</span>
          <span class="pdp-upsell-body">
            <span class="pdp-upsell-tag" data-i18n="promo.offer_tag">Ofertă</span>
            <b class="pdp-upsell-title"><span data-i18n="offer.get_in">Ia-l în</span> {{ offer.title }}</b>
            <span class="pdp-upsell-list">
              {%- for part in settings.offer_parts -%}{{ part.title }}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}
              {%- for x in offer_extras -%}
                {%- assign x_en = offer_extras_en[forloop.index0] | strip -%}, <span{% if x_en != blank %} data-i18n-en="{{ x_en | escape }}"{% endif %}>{{ x | strip }}</span>
              {%- endfor -%}.
            </span>
            <span class="pdp-upsell-row">
              <strong>{{ offer.price | money_without_trailing_zeros }}</strong>
              {%- if offer_save > 0 -%}<span class="save-chip"><span data-i18n="promo.save">Economisești</span> {{ offer_save | money_without_trailing_zeros }}</span>{%- endif -%}
              <span class="pdp-upsell-link"><span data-i18n="offer.see">Vezi setul</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Specs come after the buy block (owner's call, 2026-09-23): choose,
        add to cart, then read the details. ma-product.js turns the
        description's "Label: Value" bullets into spec rows.
      {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="product-desc">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Sticky add-to-cart bar (mobile), shown by JS once the main button scrolls away {%- endcomment -%}
  <div class="pdp-sticky" data-pdp-sticky>
    <div class="pdp-sticky-info">
      <span class="pdp-sticky-name">{{ product.title }}</span>
      <span class="pdp-sticky-price" data-sticky-price>{{ product.price | money }}</span>
    </div>
    <button type="button" class="btn btn-steel pdp-sticky-add" data-sticky-add {% unless product.available %}disabled{% endunless %}>
      <span data-i18n="product.add">Adaugă în coș</span>
    </button>
  </div>
</div>
