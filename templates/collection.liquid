{%- comment -%} MiniAnglers — catalog page (routes.all_products_collection_url and any other collection) {%- endcomment -%}
{%- assign eng_handle = settings.engraving_product.handle | default: 'gravare' -%}
{%- assign count = collection.products.size -%}
{%- for product in collection.products -%}
  {%- if product.handle == eng_handle -%}{%- assign count = count | minus: 1 -%}{%- endif -%}
{%- endfor -%}
<div class="page-wrap">
  <div class="page-head">
    <span class="eyebrow glow">{{ collection.metafields.custom.eyebrow | default: 'Magazin' }}</span>
    {%- if collection.handle == 'all' or collection.title == blank -%}
      <h1 data-i18n="catalog.title">Produse</h1>
    {%- else -%}
      <h1>{{ collection.title }}</h1>
    {%- endif -%}
    {%- if collection.description != blank -%}
      <p class="page-lead">{{ collection.description }}</p>
    {%- else -%}
      <p class="page-lead" data-i18n="catalog.lead">Sisteme de pescuit imprimate 3D, gata de personalizat cu numele tău.</p>
    {%- endif -%}
    <span class="mono">{% if count == 1 %}1 produs{% else %}{{ count }} produse{% endif %}</span>
  </div>

  <div class="product-grid" style="margin-top:8px">
    {%- if collection.handle == 'all' -%}
      {%- comment -%} Display order: Theme settings > Shop > Product order (owner-typed list), see ma-product-order.
        Other, real collections (e.g. a merchant-curated one) keep their own Admin-set order below. {%- endcomment -%}
      {%- capture order_str -%}{% render 'ma-product-order' %}{%- endcapture -%}
      {%- assign ordered_handles = order_str | strip | split: '|' -%}
      {%- for handle in ordered_handles -%}
        {%- assign product = all_products[handle] -%}
        {% render 'ma-pcard', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for product in collection.products -%}
        {%- if product.handle == eng_handle -%}{%- continue -%}{%- endif -%}
        {% render 'ma-pcard', product: product %}
      {%- endfor -%}
    {%- endif -%}
    {%- if count == 0 -%}
      <p class="shop-empty" data-i18n="shop.empty">Primele produse apar în curând.</p>
    {%- endif -%}
  </div>
</div>
