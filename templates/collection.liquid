{%- comment -%} MiniAnglers — catalog page (routes.all_products_collection_url and any other collection) {%- endcomment -%}
{%- assign count = collection.products.size -%}
<div class="page-wrap">
  <div class="page-head">
    <span class="eyebrow glow">{{ collection.metafields.custom.eyebrow | default: 'Magazin' }}</span>
    <h1>{{ collection.title | default: 'Toate produsele' }}</h1>
    {%- if collection.description != blank -%}
      <p class="page-lead">{{ collection.description }}</p>
    {%- else -%}
      <p class="page-lead">Sisteme de pescuit imprimate 3D, gata de personalizat cu numele tău.</p>
    {%- endif -%}
    <span class="mono">{% if count == 1 %}1 produs{% else %}{{ count }} produse{% endif %}</span>
  </div>

  <div class="product-grid" style="margin-top:8px">
    {%- for product in collection.products -%}
      <a class="pcard" href="{{ product.url }}">
        <div class="pcard-media">
          {%- if product.type != blank -%}<span class="glass-tag">{{ product.type }}</span>{%- endif -%}
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy">
          {%- else -%}<div class="mini-box"></div>{%- endif -%}
        </div>
        <div class="pcard-body">
          <h3>{{ product.title }}</h3>
          <p>{{ product.description | strip_html | truncatewords: 14 }}</p>
          <div class="pcard-foot">
            <span class="pcard-price">{{ product.price | money }}</span>
            <span class="btn btn-glass btn-sm" data-i18n="products.view">Vezi produsul</span>
          </div>
        </div>
      </a>
    {%- else -%}
      <p style="color:var(--steel-500)">Încă nu există produse.</p>
    {%- endfor -%}
  </div>
</div>
