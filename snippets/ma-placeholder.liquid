{%- comment -%}
  MiniAnglers — on-brand media placeholder shown until a product photo exists.
  Draws the compartment-tray silhouette (the product line's signature shape)
  with a quiet "photo coming" tag, so a photo-less product reads as intentional
  rather than broken. Vanishes automatically once a real image is added.
  Usage: {% render 'ma-placeholder' %}  ·  hide the tag with {% render 'ma-placeholder', label: false %}
{%- endcomment -%}
<div class="ma-ph">
  <svg class="ma-ph-art" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="18" y="20" width="164" height="120" rx="12" fill="none" stroke="var(--neon)" stroke-width="2"/>
    <g fill="none" stroke="var(--neon-deep)" stroke-width="1.6">
      <circle cx="52" cy="54" r="18"/><circle cx="100" cy="54" r="18"/><circle cx="148" cy="54" r="18"/>
      <circle cx="52" cy="102" r="18"/><circle cx="100" cy="102" r="18"/><circle cx="148" cy="102" r="18"/>
    </g>
    <g fill="var(--neon)"><circle cx="52" cy="54" r="7"/><circle cx="148" cy="54" r="7"/><circle cx="100" cy="102" r="7"/></g>
  </svg>
  {%- unless label == false -%}
    <span class="ma-ph-tag" data-i18n="product.photo_soon">Foto în curând</span>
  {%- endunless -%}
</div>
