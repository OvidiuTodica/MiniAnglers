{%- comment -%}
  MiniAnglers — JSON-LD structured data for Google.
  • Organization  — brand name, site, and logo (helps Google show the favicon,
    the brand, and eventually a knowledge panel).
  • WebSite + SearchAction — declares the on-site search URL, which is what
    lets Google offer a search box / sitelinks for the brand.
  • Product + BreadcrumbList (product pages only) — price, currency, and
    in-stock state for rich product results.
  Rendered in <head> via {% render 'ma-schema' %}.
{%- endcomment -%}
{%- assign root = shop.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ root | json }},
  "logo": {{ 'minianglers-logo.svg' | asset_url | prepend: 'https:' | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ root | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ root | append: '/search?q={search_term_string}' | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- if request.page_type == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  {%- if product.description != blank %}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  {%- endif %}
  {%- if product.featured_image %}
  "image": [
    {%- for image in product.images -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "url": {{ product.url | prepend: root | json }},
  "offers": {
    "@type": "Offer",
    "url": {{ product.url | prepend: root | json }},
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ product.price | divided_by: 100.0 }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Acasă", "item": {{ root | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product.url | prepend: root | json }} }
  ]
}
</script>
{%- endif -%}
