<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#177A48">
  <script>try{if('scrollRestoration' in history){history.scrollRestoration='manual';}}catch(e){}</script>
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="google-site-verification" content="lmxcXvklA1Sqy_21HBQYgsdIAO3QZTpvJNZl9OZbWWk">
  {%- comment -%}
    SEO titles + descriptions. Anything set in Admin ("Search engine listing" on a
    product/page, or Online Store → Preferences for the homepage) wins; the values
    below are fallbacks for what's left empty. Pages whose Admin title is still the
    bare handle (e.g. "faq") get a proper Romanian title here.
  {%- endcomment -%}
  {%- assign eng_handle = settings.engraving_product.handle | default: 'gravare' -%}
  {%- liquid
    assign meta_title = page_title
    assign meta_desc = page_description
    assign noindex = false
    case request.page_type
      when 'index'
        if page_title == shop.name
          assign meta_title = 'MiniAnglers — Bacuri de nadă și suporturi wafters printate 3D'
        endif
        if meta_desc == blank
          assign meta_desc = 'Bacuri de nadă, suporturi pentru wafters și gel, printate 3D în România. Gravare personalizată cu numele tău. Comandă online, livrare în toată țara.'
        endif
      when 'collection'
        if collection.handle == 'all'
          assign meta_title = 'Produse — bacuri de nadă și suporturi wafters printate 3D'
          if meta_desc == blank
            assign meta_desc = 'Toate produsele MiniAnglers: seturi și bacuri de nadă XL / L / M / S și suporturi pentru wafters — printate 3D la comandă, cu gravare personalizată opțională.'
          endif
        endif
      when 'product'
        if product.handle == eng_handle
          assign noindex = true
        endif
        if meta_desc == blank and product.description != blank
          assign meta_desc = product.description | strip_html | strip_newlines | truncate: 155
        endif
      when 'page'
        case page.handle
          when 'despre'
            if page.title == page.handle
              assign meta_title = 'Despre noi'
            endif
            assign fallback_desc = 'Cine e MiniAnglers: pescari din Timiș care își proiectează și printează 3D propriile bacuri de nadă și suporturi pentru wafters, făcute la comandă.'
          when 'procesul'
            assign fallback_desc = 'Cum facem fiecare piesă: proiectare, printare 3D la comandă, gravare personalizată cu numele tău și termenele de producție și livrare.'
          when 'faq'
            if page.title == page.handle
              assign meta_title = 'Întrebări frecvente'
            endif
            assign fallback_desc = 'Răspunsuri la întrebările frecvente despre gravare, termene de producție, livrare, retur și îngrijirea produselor MiniAnglers printate 3D.'
          when 'contact'
            assign fallback_desc = 'Scrie-ne pentru comenzi, gravare personalizată sau orice întrebare despre bacurile de nadă și suporturile MiniAnglers.'
          when 'livrare'
            if page.title == page.handle
              assign meta_title = 'Livrare'
            endif
            assign fallback_desc = 'Politica de livrare MiniAnglers: curier, termene de producție pentru piesele printate 3D și livrare în toată România.'
          when 'retur-si-rambursare'
            if page.title == page.handle
              assign meta_title = 'Retur și rambursare'
            endif
            assign fallback_desc = 'Dreptul de retragere în 14 zile, cum returnezi un produs MiniAnglers și ce se întâmplă cu produsele gravate personalizat.'
          when 'termeni-si-conditii'
            assign fallback_desc = 'Termenii și condițiile de vânzare MiniAnglers: comenzi, prețuri, plată, livrare, personalizare prin gravare și garanție.'
          when 'confidentialitate'
            if page.title == page.handle
              assign meta_title = 'Politica de confidențialitate'
            endif
            assign fallback_desc = 'Cum colectăm, folosim și protejăm datele tale personale când comanzi de la MiniAnglers, conform GDPR.'
        endcase
        if meta_desc == blank and fallback_desc != blank
          assign meta_desc = fallback_desc
        endif
      when 'search'
        assign meta_title = 'Căutare'
        assign noindex = true
      when 'cart'
        assign meta_title = 'Coșul tău'
        assign noindex = true
      when '404'
        assign meta_title = 'Pagina nu a fost găsită'
        assign noindex = true
    endcase
  -%}
  {%- if noindex -%}<meta name="robots" content="noindex">{%- endif -%}

  <title>
    {{ meta_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless meta_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if meta_desc %}<meta name="description" content="{{ meta_desc | escape }}">{% endif %}

  {%- comment -%}
    Brand mark (the "m" from the logo). The 192px PNG comes first on purpose: Google Search
    reads PNG/ICO favicons only (no SVG), wants > 48px, and must not meet the SVG first.
    Browsers still pick the SVG/32px icons for the tab; touch icon is for home screens.
  {%- endcomment -%}
  <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

  {%- comment -%} Open Graph / social sharing {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ meta_title | default: shop.name }}">
  {% if meta_desc %}<meta property="og:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if request.page_type == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:image" content="https:{{ 'og-image.png' | asset_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ 'minianglers.css' | asset_url | stylesheet_tag }}

  {% render 'ma-schema' %}

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  {% section 'ma-announce' %}
  {% section 'ma-header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'ma-footer' %}

  <script src="{{ 'ma-i18n.js' | asset_url }}" defer></script>
  <script src="{{ 'ma-product.js' | asset_url }}" defer></script>
  <script src="{{ 'ma-cart.js' | asset_url }}" defer></script>
</body>
</html>
