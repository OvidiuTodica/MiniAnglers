<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#177A48">
  <script>try{if('scrollRestoration' in history){history.scrollRestoration='manual';}}catch(e){}</script>
  <link rel="canonical" href="{{ canonical_url }}">

  {%- liquid
    assign meta_title = page_title
    assign meta_desc = page_description
    if request.page_type == 'index' and page_title == shop.name
      assign meta_title = shop.name | append: ' — Sisteme de pescuit de precizie, imprimate 3D'
    endif
    if meta_desc == blank and request.page_type == 'index'
      assign meta_desc = 'Bacuri de nadă, suporturi pentru wafters și gel — imprimate 3D în România și personalizabile prin gravare. Comandă online, cu livrare în toată țara.'
    endif
  -%}

  <title>
    {{ meta_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless meta_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if meta_desc %}<meta name="description" content="{{ meta_desc | escape }}">{% endif %}

  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

  {%- comment -%} Open Graph / social sharing {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ meta_title | default: shop.name }}">
  {% if meta_desc %}<meta property="og:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if request.page_type == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ 'minianglers.css' | asset_url | stylesheet_tag }}

  {% render 'ma-schema' %}

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  {% section 'ma-announce' %}
  {% section 'ma-header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'ma-footer' %}

  <script src="{{ 'ma-i18n.js' | asset_url }}" defer></script>
  <script src="{{ 'ma-product.js' | asset_url }}" defer></script>
  <script src="{{ 'ma-cart.js' | asset_url }}" defer></script>
</body>
</html>
