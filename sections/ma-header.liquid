{%- comment -%} MiniAnglers header — storefront: logo, search, actions + category nav {%- endcomment -%}
<nav class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand-word" href="{{ routes.root_url }}" aria-label="MiniAnglers">{{ 'minianglers-logo.svg' | inline_asset_content }}</a>

    <form class="nav-search-box" action="{{ routes.search_url }}" method="get" role="search">
      {% render 'ma-icon', icon: 'search' %}
      <input type="search" name="q" value="{{ search.terms | escape }}"
        placeholder="Caută produse..." aria-label="Caută" data-i18n-ph="search.ph" data-i18n-aria="aria.search">
    </form>

    <div class="nav-actions">
      <button class="lang-toggle" type="button" data-lang-toggle aria-label="Switch to English">EN</button>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Contul meu" data-i18n-aria="aria.account">{% render 'ma-icon', icon: 'user' %}</a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Coș" data-i18n-aria="aria.cart">
        {% render 'ma-icon', icon: 'cart' %}
        <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="catnav">
    <div class="catnav-inner">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="is-active" data-i18n="catnav.all">Toate produsele</a>
        <a href="#shop" data-i18n="catnav.bacuri">Bacuri de nadă</a>
        <a href="#shop" data-i18n="catnav.wafters">Suporturi wafters</a>
        <a href="#shop" data-i18n="catnav.gel">Suporturi gel &amp; dip</a>
        <a href="#gravare" data-i18n="catnav.gravare">Gravare</a>
      {%- endif -%}
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Category nav menu (optional)" }
  ]
}
{% endschema %}
