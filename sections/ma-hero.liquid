{%- comment -%}
  MiniAnglers hero. Two states:
  - No offer product picked: the green banner with the owner's copy (tag / headline / sub
    text / button), copy only, as decided 2026-09-21.
  - Offer set picked in Theme settings > Offer & sales (and available): an offer card for
    that product (its photo with labels pinned on the real parts, its live price) and, right
    under it, the owner's copy in a white card so it stays on the homepage (owner's call,
    2026-09-23).
  The "bought separately" line is the live price sum of the offer's pieces (ma-offer-sum)
  and only shows when every piece is for sale and the sum beats the set price, so the
  comparison is always true (EU/RO rule: no invented "old" prices).
  Method Champions (Theme settings > Method Champions > page picked): the banner splits in
  two (owner's pick, mockup variant 4, 2026-10-14): the offer in a narrow green column on the
  left, Method Champions large on the right. Phones: Method Champions first, the offer as one
  green row under it. The Method Champions picture is a render of the real 3D models;
  ma-champions.js lays the name typed in the card onto every piece (corners of each engraving
  zone, measured on that render, in data-zones), and the form opens the configurator page with
  the name (?nume=).
  Text fields left empty in the theme editor fall back to the standard copy (RO default,
  EN via data-i18n). Anything typed in the editor is shown as typed and is never
  overwritten by the dictionary; each field has an optional "(English)" twin that the
  toggle swaps in via data-i18n-en (ma-i18n.js), empty twin = Romanian shows in EN too.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign offer = settings.offer_product -%}
{%- assign offer_on = false -%}
{%- if offer != blank and offer.available -%}{%- assign offer_on = true -%}{%- endif -%}
{%- assign champ_page = settings.champions_page -%}
{%- assign split = false -%}
{%- if champ_page != blank -%}{%- assign split = true -%}{%- endif -%}

{%- capture brand_tag -%}<span class="promo-tag"{% if s.tag == blank %} data-i18n="promo.tag"{% elsif s.tag_en != blank %} data-i18n-en="{{ s.tag_en | escape }}"{% endif %}>{{ s.tag | default: 'Printat 3D în Timiș' }}</span>{%- endcapture -%}
{%- capture brand_title -%}<h1{% if s.title == blank %} data-i18n="promo.title"{% elsif s.title_en != blank %} data-i18n-en="{{ s.title_en | escape }}"{% endif %}>{{ s.title | default: 'Toată nada ta, la locul ei.' }}</h1>{%- endcapture -%}
{%- capture brand_sub -%}<p{% if s.subtext == blank %} data-i18n="promo.sub"{% elsif s.subtext_en != blank %} data-i18n-en="{{ s.subtext_en | escape }}"{% endif %}>{{ s.subtext | default: 'Cutii și suporturi pentru wafters, gel și pop-up, printate 3D. Le gravăm cu numele tău, dacă vrei.' }}</p>{%- endcapture -%}
{%- capture brand_cta_label -%}<span{% if s.cta_label == blank %} data-i18n="promo.cta"{% elsif s.cta_label_en != blank %} data-i18n-en="{{ s.cta_label_en | escape }}"{% endif %}>{{ s.cta_label | default: 'Vezi produsele' }}</span>{%- endcapture -%}
{%- assign brand_cta_href = s.cta_link | default: routes.all_products_collection_url -%}

{%- capture offer_card -%}
    {%- if offer_on -%}
      {%- capture parts_sum -%}{% render 'ma-offer-sum' %}{%- endcapture -%}
      {%- assign parts_sum = parts_sum | strip | plus: 0 -%}
      {%- assign savings = parts_sum | minus: offer.price -%}
      {%- assign show_compare = false -%}
      {%- if parts_sum > 0 and savings > 0 -%}{%- assign show_compare = true -%}{%- endif -%}
      {%- assign img = offer.featured_image -%}

      <div class="offer-card">
        <div class="offer-copy">
          <span class="promo-tag"{% if s.offer_tag == blank %} data-i18n="promo.offer_tag"{% elsif s.offer_tag_en != blank %} data-i18n-en="{{ s.offer_tag_en | escape }}"{% endif %}>{{ s.offer_tag | default: 'Ofertă' }}</span>
          <h2 class="offer-title">{{ offer.title }}</h2>
          <p class="offer-sub"{% if s.offer_sub == blank %} data-i18n="promo.offer_sub"{% elsif s.offer_sub_en != blank %} data-i18n-en="{{ s.offer_sub_en | escape }}"{% endif %}>{{ s.offer_sub | default: 'Patru bacuri și două suporturi care se îmbină într-un singur setup.' }}</p>
          {%- if section.blocks.size > 0 -%}
            <ul class="offer-chips">
              {%- for block in section.blocks -%}
                {%- if block.settings.label != blank -%}
                  <li {{ block.shopify_attributes }}><span{% if block.settings.label_en != blank %} data-i18n-en="{{ block.settings.label_en | escape }}"{% endif %}>{{ block.settings.label }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="offer-price">
            <span class="offer-now">{{ offer.price | money_without_trailing_zeros }}</span>
            {%- if offer.compare_at_price > offer.price -%}
              <s class="offer-was">{{ offer.compare_at_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
            {%- if show_compare -%}
              <span class="offer-save"><span data-i18n="promo.save">Economisești</span> {{ savings | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </div>
          {%- if show_compare -%}
            <p class="offer-sep"><span data-i18n="promo.separately">Cumpărate separat:</span> {{ parts_sum | money_without_trailing_zeros }}</p>
          {%- endif -%}
          <a class="promo-cta" href="{{ offer.url }}">
            <span{% if s.offer_cta == blank %} data-i18n="promo.offer_cta"{% elsif s.offer_cta_en != blank %} data-i18n-en="{{ s.offer_cta_en | escape }}"{% endif %}>{{ s.offer_cta | default: 'Vreau setul' }}</span>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>

        <a class="offer-shot" href="{{ offer.url }}" tabindex="-1" aria-hidden="true">
          {%- if img != blank -%}
            {%- comment -%}
              The page's largest element (LCP). preload: true makes Shopify send it as an early
              Link header, so the phone starts downloading the photo before the HTML arrives.
              sizes = the photo's real width per breakpoint, so a phone gets ~700px, not 900+.
            {%- endcomment -%}
            {{ img | image_url: width: 1400 | image_tag:
                 widths: '400, 550, 700, 900, 1100, 1400',
                 sizes: '(max-width: 760px) calc(100vw - 60px), (max-width: 900px) calc(50vw - 67px), (max-width: 1200px) calc(54vw - 97px), 560px',
                 alt: '', fetchpriority: 'high', preload: true }}
          {%- else -%}
            {% render 'ma-placeholder' %}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <span class="offer-pin{% if block.settings.side == 'left' %} is-left{% endif %}" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%;--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <span class="offer-pin-in"><i></i><em><span{% if block.settings.label_en != blank %} data-i18n-en="{{ block.settings.label_en | escape }}"{% endif %}>{{ block.settings.label }}</span>{%- if block.settings.note != blank %} <small>{{ block.settings.note }}</small>{% endif -%}</em></span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </a>
      </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture brand_card -%}
      <div class="promo-card">
        <div class="promo-copy">
          {{ brand_tag }}
          {{ brand_title }}
          {{ brand_sub }}
          <a class="promo-cta" href="{{ brand_cta_href }}">{{ brand_cta_label }}</a>
        </div>
      </div>
{%- endcapture -%}

{%- if split -%}
  {%- capture champ_card -%}
    {%- assign cp = settings.champions_product -%}
    {%- assign champ_url = champ_page.url -%}
    {%- if cp != blank and cp.available -%}{%- assign champ_url = cp.url -%}{%- endif -%}
    <article class="champ-card" data-champ data-font="{{ 'ma-engr-archivo-black-400-latin.woff2' | asset_url }}" data-font-ext="{{ 'ma-engr-archivo-black-400-latin-ext.woff2' | asset_url }}">
      <div class="champ-head">
        <span class="promo-tag champ-tag"{% if s.champ_tag == blank %} data-i18n="promo.champ_tag"{% elsif s.champ_tag_en != blank %} data-i18n-en="{{ s.champ_tag_en | escape }}"{% endif %}>{{ s.champ_tag | default: 'Nou' }}</span>
        <h2 class="champ-title">Method Champions</h2>
        <p class="champ-sub"{% if s.champ_sub == blank %} data-i18n="promo.champ_sub"{% elsif s.champ_sub_en != blank %} data-i18n-en="{{ s.champ_sub_en | escape }}"{% endif %}>{{ s.champ_sub | default: 'Setul de concurs. Scrie un nume și vezi-l pe fiecare piesă.' }}</p>
        {%- if cp != blank and cp.available -%}
          {%- assign cvs = cp.variants | where: 'available' | sort: 'price' -%}
          <p class="champ-price"><span data-i18n="promo.champ_from">Setul de la</span> <b>{{ cvs.first.price | money_without_trailing_zeros }}</b></p>
        {%- endif -%}
      </div>
      <a class="champ-shot" href="{{ champ_url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ 'ma-champions-set.webp' | asset_url }}"
             srcset="{{ 'ma-champions-set-720.webp' | asset_url }} 720w, {{ 'ma-champions-set.webp' | asset_url }} 1200w"
             sizes="(max-width: 900px) calc(100vw - 36px), (max-width: 1200px) 56vw, 660px"
             width="1200" height="750" alt="" decoding="async">
        <span class="champ-etch" data-champ-etch data-zones='[{"k":"bac","q":[[0.0482,0.36055],[0.19742,0.37584],[0.21304,0.53638],[0.07166,0.52083]]},{"k":"bac","q":[[0.28246,0.38455],[0.43502,0.40019],[0.43794,0.5611],[0.29356,0.54523]]},{"k":"bac","q":[[0.52197,0.4091],[0.67799,0.4251],[0.66764,0.58637],[0.52018,0.57014]]},{"k":"bac","q":[[0.76692,0.4342],[0.92651,0.45056],[0.90229,0.61216],[0.75165,0.59559]]},{"k":"suport_waftere","q":[[0.16387,0.71437],[0.22056,0.72109],[0.21766,0.744],[0.16068,0.73717]]},{"k":"suport_gel","q":[[0.38096,0.58219],[0.56232,0.60235],[0.56091,0.62911],[0.37831,0.60857]]},{"k":"suport_waftere","q":[[0.70302,0.77831],[0.76263,0.78538],[0.76251,0.8092],[0.70259,0.80203]]}]'></span>
      </a>
      <form class="champ-try" action="{{ champ_url }}" method="get">
        <label class="champ-label" for="champ-name" data-i18n="promo.champ_label">Scrie un nume și vezi-l pe set</label>
        <input class="champ-input" id="champ-name" name="nume" maxlength="20" placeholder="Numele tău" data-i18n-ph="promo.champ_ph" autocomplete="off" spellcheck="false" enterkeyhint="go" data-champ-input>
        <button class="champ-cta" type="submit">
          <span{% if s.champ_cta == blank %} data-i18n="promo.champ_cta"{% elsif s.champ_cta_en != blank %} data-i18n-en="{{ s.champ_cta_en | escape }}"{% endif %}>{{ s.champ_cta | default: 'Configurează setul' }}</span>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </article>
  {%- endcapture -%}
{%- endif -%}

<section class="promo{% if split %} is-split{% endif %}" id="sistem">
  <div class="section">
    {%- if split -%}
      <div class="hero-split">
        <div class="hero-slot hero-slot-offer">{% if offer_on %}{{ offer_card }}{% else %}{{ brand_card }}{% endif %}</div>
        <div class="hero-slot hero-slot-champ">{{ champ_card }}</div>
      </div>
    {%- elsif offer_on -%}
      {{ offer_card }}
    {%- else -%}
      {{ brand_card }}
    {%- endif -%}

    {%- if offer_on -%}
      <div class="promo-note">
        <div class="promo-note-head">
          {{ brand_tag }}
          {{ brand_title }}
        </div>
        <div class="promo-note-body">
          {{ brand_sub }}
          <a class="promo-note-link" href="{{ brand_cta_href }}">{{ brand_cta_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- if split -%}<script src="{{ 'ma-champions.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "Hero (promo)",
  "settings": [
    { "type": "paragraph", "content": "Green banner with your text. Leave a field empty to keep the standard text (shown in RO and EN). Anything you type here replaces it, exactly as typed. The \"(English)\" fields are shown when a visitor switches to EN — leave them empty and the Romanian text shows in both languages." },
    { "type": "text", "id": "tag", "label": "Tag", "placeholder": "Printat 3D în Timiș" },
    { "type": "text", "id": "tag_en", "label": "Tag (English)" },
    { "type": "text", "id": "title", "label": "Headline", "placeholder": "Toată nada ta, la locul ei." },
    { "type": "text", "id": "title_en", "label": "Headline (English)" },
    { "type": "textarea", "id": "subtext", "label": "Sub text", "placeholder": "Cutii și suporturi pentru wafters, gel și pop-up, printate 3D. Le gravăm cu numele tău, dacă vrei." },
    { "type": "textarea", "id": "subtext_en", "label": "Sub text (English)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "placeholder": "Vezi produsele" },
    { "type": "text", "id": "cta_label_en", "label": "Button label (English)" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Empty = all products." },

    { "type": "header", "content": "Offer" },
    { "type": "paragraph", "content": "The set on offer and its pieces are picked in Theme settings > Offer & sales. While an offer is on, this banner shows it (photo, labels, live price) and your text above moves into a white card under it. Stop the offer there to bring the green banner back." },
    { "type": "text", "id": "offer_tag", "label": "Offer tag", "placeholder": "Ofertă" },
    { "type": "text", "id": "offer_tag_en", "label": "Offer tag (English)" },
    { "type": "textarea", "id": "offer_sub", "label": "Offer text", "placeholder": "Patru bacuri și două suporturi care se îmbină într-un singur setup." },
    { "type": "textarea", "id": "offer_sub_en", "label": "Offer text (English)" },
    { "type": "text", "id": "offer_cta", "label": "Offer button", "placeholder": "Vreau setul" },
    { "type": "text", "id": "offer_cta_en", "label": "Offer button (English)" },

    { "type": "header", "content": "Method Champions" },
    { "type": "paragraph", "content": "When a page is picked in Theme settings > Method Champions, the banner splits in two: the offer on the left, Method Champions on the right, where visitors type a name and see it on the set. Empty fields keep the standard text." },
    { "type": "text", "id": "champ_tag", "label": "Tag", "placeholder": "Nou" },
    { "type": "text", "id": "champ_tag_en", "label": "Tag (English)" },
    { "type": "textarea", "id": "champ_sub", "label": "Text", "placeholder": "Setul de concurs. Scrie un nume și vezi-l pe fiecare piesă." },
    { "type": "textarea", "id": "champ_sub_en", "label": "Text (English)" },
    { "type": "text", "id": "champ_cta", "label": "Button", "placeholder": "Configurează setul" },
    { "type": "text", "id": "champ_cta_en", "label": "Button (English)" }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "Photo label",
      "settings": [
        { "type": "paragraph", "content": "A label pinned on the offer photo. Move it with the two sliders until the dot sits on the right piece." },
        { "type": "text", "id": "label", "label": "Label", "placeholder": "Bac XL" },
        { "type": "text", "id": "label_en", "label": "Label (English)" },
        { "type": "text", "id": "note", "label": "Small detail (optional)", "placeholder": "21 × 13 cm" },
        { "type": "range", "id": "x", "label": "Left to right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Top to bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "select", "id": "side", "label": "Text side", "default": "right", "options": [
          { "value": "right", "label": "Right of the dot" },
          { "value": "left", "label": "Left of the dot" }
        ] }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Hero (promo)" }]
}
{% endschema %}
