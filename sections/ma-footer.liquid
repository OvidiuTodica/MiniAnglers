{%- comment -%} MiniAnglers footer (RO default, EN via data-i18n) {%- endcomment -%}
{%- assign s = section.settings -%}
<footer class="footer">
  <div class="section">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-word" aria-label="MiniAnglers">{% render 'ma-logo' %}</span>
        <div class="footer-tag" data-i18n="footer.tagline">{{ s.tagline | default: 'Totul la locul lui.' }}</div>
        <p class="footer-sub" data-i18n="footer.blurb">{{ s.blurb | default: 'Cutii pentru nadă și suporturi, printate 3D în Timiș.' }}</p>
        {%- if s.social_instagram != blank or s.social_facebook != blank or s.social_tiktok != blank -%}
        <div class="footer-social" aria-label="Rețele sociale">
          {%- if s.social_instagram != blank -%}
          <a href="{{ s.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>
          {%- endif -%}
          {%- if s.social_facebook != blank -%}
          <a href="{{ s.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.2h2.4l.4-2.9h-2.8V9.1c0-.8.3-1.4 1.4-1.4h1.5V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8v2.9h2.5V21h3z"/></svg></a>
          {%- endif -%}
          {%- if s.social_tiktok != blank -%}
          <a href="{{ s.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.2 3h2.6c.2 1.9 1.4 3.4 3.3 3.8l.4.1v2.7c-1.4 0-2.7-.5-3.8-1.3v6.3c0 3-2.4 5.4-5.4 5.4S5 17.6 5 14.6s2.4-5.4 5.4-5.4c.3 0 .6 0 .9.1v2.8a2.6 2.6 0 0 0-.9-.2 2.7 2.7 0 1 0 2.7 2.7V3z"/></svg></a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <div class="footer-col">
          <h4 data-i18n="footer.company">Companie</h4>
          <a href="/pages/despre" data-i18n="footer.company0">Despre noi</a>
          <a href="/pages/procesul" data-i18n="nav.process">Procesul</a>
          <a href="/pages/contact" data-i18n="footer.company1">Contact</a>
          <a href="/pages/faq" data-i18n="footer.company2">Întrebări frecvente</a>
          {%- if customer -%}{%- assign f_acct = routes.account_url -%}
          {%- else -%}{%- assign f_acct = routes.storefront_login_url | default: routes.account_login_url -%}{%- endif -%}
          <a href="{{ f_acct }}" data-i18n="footer.account">Contul meu</a>
        </div>
      {%- endif -%}

      {%- if s.show_newsletter -%}
        <div class="footer-col">
          <h4 data-i18n="footer.news_title">{{ s.newsletter_title | default: 'Rămâi la curent' }}</h4>
          <p class="footer-sub" data-i18n="footer.news_text">{{ s.newsletter_text | default: 'Produse noi și reveniri în stoc. Fără spam.' }}</p>
          {%- form 'customer' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="news">
              <input type="email" name="contact[email]" placeholder="email@exemplu.com" aria-label="Adresă de email" required>
              <button class="btn btn-steel btn-sm" type="submit" data-i18n="footer.join">Abonează-te</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="footer-sub" style="margin-top:8px;color:var(--teal)">Mulțumim, ești pe listă.</p>{%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer-fine">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. <span data-i18n="footer.rights">Toate drepturile rezervate.</span></span>
      <span class="footer-legal">
        <a href="/pages/confidentialitate" data-i18n="footer.legal1">Confidențialitate</a> ·
        <a href="/pages/termeni-si-conditii" data-i18n="footer.legal2">Termeni și condiții</a> ·
        <a href="/pages/retur-si-rambursare" data-i18n="footer.legal3">Retur și rambursare</a> ·
        <a href="/pages/livrare" data-i18n="footer.legal4">Livrare</a>
      </span>
      {%- comment -%} Mandatory for Romanian online shops: ANPC alternative dispute resolution (SAL) + EU online dispute resolution (SOL/ODR) {%- endcomment -%}
      <span class="footer-legal footer-anpc">
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener" data-i18n="footer.anpc_sal">ANPC – SAL</a> ·
        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener" data-i18n="footer.anpc_sol">SOL – Soluționarea online a litigiilor</a>
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Totul la locul lui." },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Cutii pentru nadă și suporturi, printate 3D în Timiș." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "Rămâi la curent" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Produse noi și reveniri în stoc. Fără spam." },
    { "type": "header", "content": "Rețele sociale" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Magazin" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
