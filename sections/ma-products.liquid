{%- comment -%}
  MiniAnglers products — homepage grid, read straight from the catalog (RO default, EN via data-i18n).
  Publish a product in Admin and it shows up here; its first photo replaces the placeholder automatically.
  Skipped: the engraving add-on (settings.engraving_product) — charged from the product page, never browsed.
  Badges come from product tags: "nou" → Nou, "bestseller" → Best seller.
  Filter chips come from Product type and only appear once two or more types exist.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign eng_handle = settings.engraving_product.handle | default: 'gravare' -%}
{%- assign max_cards = s.limit | default: 12 -%}

{%- comment -%} Pass 1: how many cards will show, and which product types exist {%- endcomment -%}
{%- assign shown = 0 -%}
{%- assign types = '' -%}
{%- for product in collections.all.products limit: 50 -%}
  {%- if product.handle == eng_handle -%}{%- continue -%}{%- endif -%}
  {%- if shown >= max_cards -%}{%- break -%}{%- endif -%}
  {%- assign shown = shown | plus: 1 -%}
  {%- if product.type != blank -%}
    {%- assign key = '|' | append: product.type | append: '|' -%}
    {%- assign wrapped = '|' | append: types -%}
    {%- unless wrapped contains key -%}
      {%- assign types = types | append: product.type | append: '|' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign type_list = types | split: '|' -%}

<section class="products" id="shop">
  <div class="section">
    <div class="shop-tools">
      <h2 data-i18n="shop.heading">{{ s.heading | default: 'Toate produsele' }}</h2>
      {%- if type_list.size > 1 -%}
        <button class="chip is-active" type="button" data-filter="all" data-i18n="shop.f_all">Toate</button>
        {%- for t in type_list -%}
          {%- assign tl = t | downcase -%}
          {%- assign i18n = '' -%}
          {%- if tl contains 'bac' -%}{%- assign i18n = 'shop.f_bacuri' -%}
          {%- elsif tl contains 'suport' -%}{%- assign i18n = 'shop.f_suporturi' -%}{%- endif -%}
          <button class="chip" type="button" data-filter="{{ t | handleize }}"{% if i18n != '' %} data-i18n="{{ i18n }}"{% endif %}>{{ t }}</button>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if shown == 0 -%}
      <p class="shop-empty" data-i18n="shop.empty">Primele produse apar în curând.</p>
    {%- else -%}
    <div class="scards" id="shopGrid">
      {%- assign rendered = 0 -%}
      {%- for product in collections.all.products limit: 50 -%}
        {%- if product.handle == eng_handle -%}{%- continue -%}{%- endif -%}
        {%- if rendered >= max_cards -%}{%- break -%}{%- endif -%}
        {%- assign rendered = rendered | plus: 1 -%}

        {%- assign badge = '' -%}
        {%- for tag in product.tags -%}
          {%- assign tl = tag | downcase | strip -%}
          {%- if tl == 'nou' or tl == 'new' -%}{%- assign badge = 'new' -%}
          {%- elsif tl == 'bestseller' or tl == 'best seller' or tl == 'best' -%}{%- assign badge = 'best' -%}{%- endif -%}
        {%- endfor -%}

        <a class="scard" href="{{ product.url }}" data-cat="{{ product.type | handleize }}">
          <div class="media">
            {%- if badge == 'new' -%}<span class="flag new" data-i18n="shop.badge_new">Nou</span>
            {%- elsif badge == 'best' -%}<span class="flag best" data-i18n="shop.badge_best">Best seller</span>{%- endif -%}
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy" width="600" height="600">
            {%- else -%}
              {% render 'ma-placeholder' %}
            {%- endif -%}
          </div>
          <div class="sbody">
            <h3>{{ product.title }}</h3>
            {%- if product.type != blank -%}<div class="cat">{{ product.type }}</div>{%- endif -%}
            <div class="foot">
              <div class="price">{{ product.price | money }}</div>
              <span class="add"><span data-i18n="products.view">Vezi produsul</span></span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('shopGrid');
    if (!grid) return;
    var chips = document.querySelectorAll('.shop-tools .chip');
    var cards = grid.querySelectorAll('.scard');
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('is-active'); });
        c.classList.add('is-active');
        var f = c.getAttribute('data-filter');
        cards.forEach(function (card) {
          card.hidden = !(f === 'all' || card.getAttribute('data-cat') === f);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Products",
  "settings": [
    { "type": "paragraph", "content": "Shows every published product except the engraving add-on. In Admin: tag a product \"nou\" or \"bestseller\" for a badge; set Product type (e.g. Bacuri / Suporturi) to get filter chips." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Toate produsele" },
    { "type": "range", "id": "limit", "label": "Max products shown", "min": 3, "max": 24, "step": 3, "default": 12 }
  ],
  "presets": [{ "name": "Products" }]
}
{% endschema %}
