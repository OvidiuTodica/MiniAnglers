{%- comment -%} MiniAnglers products — storefront grid with filter chips (RO default, EN via data-i18n) {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="products" id="shop">
  <div class="section">
    <div class="shop-tools">
      <h2 data-i18n="shop.heading">{{ s.heading | default: 'Toate produsele' }}</h2>
      <button class="chip is-active" type="button" data-filter="all" data-i18n="shop.f_all">Toate</button>
      <button class="chip" type="button" data-filter="bacuri" data-i18n="shop.f_bacuri">Bacuri</button>
      <button class="chip" type="button" data-filter="suporturi" data-i18n="shop.f_suporturi">Suporturi</button>
      <span class="shop-sort" data-i18n="shop.sort">Sortează: Populare</span>
    </div>

    <div class="scards" id="shopGrid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign p = b.product -%}
        {%- assign href = routes.all_products_collection_url -%}
        {%- if p != blank %}{% assign href = p.url %}{% endif -%}
        <a class="scard" href="{{ href }}" data-cat="{{ b.category | default: 'bacuri' }}" {{ block.shopify_attributes }}>
          <div class="media">
            {%- if b.badge == 'new' -%}<span class="flag new" data-i18n="shop.badge_new">Nou</span>
            {%- elsif b.badge == 'best' -%}<span class="flag best" data-i18n="shop.badge_best">Best seller</span>{%- endif -%}
            {%- if p != blank and p.featured_image != blank -%}
              <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.featured_image.alt | escape | default: p.title }}" loading="lazy">
            {%- else -%}
              <svg viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg" width="82%" aria-hidden="true">
                {%- case b.shape -%}
                  {%- when 'bar_long' -%}
                    <rect x="20" y="104" width="160" height="20" rx="8" fill="none" stroke="#177A48" stroke-width="2"/>
                    <g stroke="#125E38" stroke-width="6" stroke-linecap="round"><line x1="54" y1="104" x2="54" y2="60"/><line x1="94" y1="104" x2="94" y2="52"/><line x1="134" y1="104" x2="134" y2="60"/><line x1="166" y1="104" x2="166" y2="68"/></g>
                    <g fill="#177A48"><circle cx="54" cy="54" r="11"/><circle cx="94" cy="46" r="11"/><circle cx="134" cy="54" r="11"/><circle cx="166" cy="62" r="10"/></g>
                  {%- when 'bar_small' -%}
                    <rect x="46" y="72" width="108" height="48" rx="12" fill="none" stroke="#177A48" stroke-width="2"/>
                    <g fill="none" stroke="#125E38" stroke-width="1.8"><rect x="62" y="44" width="30" height="48" rx="6"/><rect x="108" y="52" width="26" height="40" rx="6"/></g>
                    <rect x="68" y="38" width="18" height="7" rx="3" fill="#177A48"/><rect x="112" y="46" width="18" height="7" rx="3" fill="#177A48"/>
                  {%- else -%}
                    <rect x="18" y="20" width="164" height="120" rx="12" fill="none" stroke="#177A48" stroke-width="2"/>
                    <g fill="none" stroke="#125E38" stroke-width="1.6"><circle cx="52" cy="54" r="18"/><circle cx="100" cy="54" r="18"/><circle cx="148" cy="54" r="18"/><circle cx="52" cy="102" r="18"/><circle cx="100" cy="102" r="18"/><circle cx="148" cy="102" r="18"/></g>
                    <g fill="#177A48"><circle cx="52" cy="54" r="7"/><circle cx="148" cy="54" r="7"/><circle cx="100" cy="102" r="7"/></g>
                {%- endcase -%}
              </svg>
            {%- endif -%}
          </div>
          <div class="sbody">
            <h3>{% if p != blank %}{{ p.title }}{% else %}{{ b.name }}{% endif %}</h3>
            <div class="cat">{{ b.cat_label | default: b.pn }}</div>
            <div class="foot">
              <div class="price">{% if p != blank %}{{ p.price | money }}{% else %}{{ b.price | default: '—' }}{% endif %}</div>
              <span class="add"><span data-i18n="products.view">Vezi produsul</span></span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('shopGrid');
    if (!grid) return;
    var chips = document.querySelectorAll('.shop-tools .chip');
    var cards = grid.querySelectorAll('.scard');
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('is-active'); });
        c.classList.add('is-active');
        var f = c.getAttribute('data-filter');
        cards.forEach(function (card) {
          card.hidden = !(f === 'all' || card.getAttribute('data-cat') === f);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Toate produsele" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product (optional — overrides text below)" },
        { "type": "text", "id": "name", "label": "Name (fallback)", "default": "Produs" },
        { "type": "text", "id": "cat_label", "label": "Category label", "default": "Bacuri de nadă" },
        { "type": "select", "id": "category", "label": "Filter group", "options": [
          {"value":"bacuri","label":"Bacuri"},
          {"value":"suporturi","label":"Suporturi"},
          {"value":"seturi","label":"Seturi"}
        ], "default": "bacuri" },
        { "type": "select", "id": "badge", "label": "Badge", "options": [
          {"value":"none","label":"Fără"},
          {"value":"new","label":"Nou"},
          {"value":"best","label":"Best seller"}
        ], "default": "none" },
        { "type": "text", "id": "pn", "label": "Part code", "default": "MA-00" },
        { "type": "select", "id": "shape", "label": "Silhouette (if no product image)", "options": [
          {"value":"set4","label":"Bac (compartimente)"},
          {"value":"bar_long","label":"Suport wafters"},
          {"value":"bar_small","label":"Suport gel"}
        ], "default": "set4" },
        { "type": "textarea", "id": "desc", "label": "Description (fallback)" },
        { "type": "header", "content": "Specs (shown on product page)" },
        { "type": "text", "id": "spec1_k", "label": "Spec 1 label" },
        { "type": "text", "id": "spec1_v", "label": "Spec 1 value" },
        { "type": "text", "id": "spec2_k", "label": "Spec 2 label" },
        { "type": "text", "id": "spec2_v", "label": "Spec 2 value" },
        { "type": "text", "id": "spec3_k", "label": "Spec 3 label" },
        { "type": "text", "id": "spec3_v", "label": "Spec 3 value" },
        { "type": "text", "id": "spec4_k", "label": "Spec 4 label" },
        { "type": "text", "id": "spec4_v", "label": "Spec 4 value" },
        { "type": "text", "id": "tags", "label": "Tags (comma separated)" },
        { "type": "text", "id": "price", "label": "Example price (fallback)", "default": "—" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Products",
      "blocks": [
        { "type": "product", "settings": {
          "name": "Set Bacuri Nadă Standard", "cat_label": "Bacuri de nadă", "category": "bacuri", "badge": "best",
          "pn": "MA-BNS", "shape": "set4",
          "desc": "Patru bacuri care se îmbină: 1 XL și 3 mărimi. Nadă sortată, totul pe tava ta.", "price": "199 lei" } },
        { "type": "product", "settings": {
          "name": "Suport Wafters v2", "cat_label": "Suporturi wafters", "category": "suporturi", "badge": "none",
          "pn": "MA-WAF", "shape": "bar_long",
          "desc": "Suport lung pentru wafters și pop-ups, aliniate și la îndemână în timpul montării.", "price": "89 lei" } },
        { "type": "product", "settings": {
          "name": "Suport Gel v2", "cat_label": "Suporturi gel & dip", "category": "suporturi", "badge": "new",
          "pn": "MA-GEL", "shape": "bar_small",
          "desc": "Compact, pentru borcanul de gel sau dip. Stă fix, fără răsturnări pe tava laterală.", "price": "39 lei" } }
      ]
    }
  ]
}
{% endschema %}
